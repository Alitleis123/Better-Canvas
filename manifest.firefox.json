{
  "manifest_version": 3,
  "name": "Better Canvas",
  "version": "1.0.0",
  "description": "Fully customize Instructure Canvas: hide/reorder/rename/recolor dashboard cards, real dark mode, theming, navigation control, custom backgrounds, custom CSS, and grade tools. Privacy-first, no telemetry.",
  "browser_specific_settings": {
    "gecko": {
      "id": "better-canvas@local.extension",
      "strict_min_version": "127.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "alarms"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": ["*://*.instructure.com/*"],
  "background": {
    "scripts": ["src/background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.instructure.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "src/shared/defaults.js",
        "src/content/core/util.js",
        "src/content/core/storage.js",
        "src/content/core/detect.js",
        "src/content/core/injector.js",
        "src/content/core/api.js",
        "src/shared/settings-ui.js",
        "src/content/features/theming.js",
        "src/content/features/cosmetics.js",
        "src/content/features/navigation.js",
        "src/content/features/dashboard.js",
        "src/content/features/todo.js",
        "src/content/features/grades.js",
        "src/content/features/settings-panel.js",
        "src/content/core/observer.js",
        "src/content/content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Better Canvas",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }
}
